---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const projects = [
  {
    name: '多协议采集服务',
    period: '2025 — now',
    desc: '插件化架构的设备数据采集服务：协议驱动以独立插件加载，支持 OPC UA / Modbus / 厂商私有协议，单服务多实例部署，内置断线重连与数据补传。',
    tags: ['.NET', 'OPCUA', 'MODBUS', 'ARCH'],
  },
  {
    name: '周界报警状态同步',
    period: '2025',
    desc: '把报警主机的状态机映射到业务库，处理跨天记录、重复上报与撤防恢复，保证前后端看到的是同一份状态。',
    tags: ['.NET', 'TASK', 'DEBUG'],
  },
  {
    name: '工业可视化前端',
    period: '2024 — 2025',
    desc: 'Vue3 + Three.js 的场站三维展示与实时数据面板，解决大场景下的 draw call 与内存泄漏问题。',
    tags: ['VUE', 'PERF'],
  },
];
---
<BaseLayout title="项目" description="在做的一些工程与项目。">
  <div class="wrap">
    <section class="hero" style="padding: 68px 0 40px;">
      <h1 style="font-size: clamp(30px, 4vw, 54px);">项目</h1>
      <p class="sub">长期在做的几件事，多数是工业现场的东西</p>
      <p class="latin">projects</p>
    </section>

    <div class="cards" style="grid-template-columns: minmax(0, 1fr);">
      {
        projects.map((p) => (
          <div class="card" style="cursor: default;">
            <div class="meta">{p.period}</div>
            <h3>{p.name}</h3>
            <p class="desc">{p.desc}</p>
            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p style="margin-top: 36px; font-family: var(--mono); font-size: 12px; color: var(--muted);">
      more on <a href={SITE.github} target="_blank" rel="noopener" style="color: var(--accent);">GitHub</a>
    </p>
  </div>
</BaseLayout>
