---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
import { SITE, url } from '../../consts';

const posts = await getPosts();
---
<BaseLayout title="全部文章" description={`${SITE.title} 的全部技术笔记，按时间倒序。`}>
  <div class="wrap">
    <section class="hero" style="padding: 68px 0 40px;">
      <h1 style="font-size: clamp(30px, 4vw, 54px);">全部文章</h1>
      <p class="sub">{posts.length} 篇 · 按发布时间倒序</p>
      <p class="latin">archive</p>
    </section>

    <div class="rows">
      {
        posts.map((post) => (
          <a class="row" href={url(`/notes/${post.id}`)}>
            <span class="row-date">
              {formatDate(post.data.pubDate)} · {readingTime(post.body)} min
            </span>
            <span class="row-title">{post.data.title}</span>
            <span class="row-tags">
              {post.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
