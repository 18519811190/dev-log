---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../lib/posts';
import { SITE, url } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const date = formatDate(post.data.pubDate);
const updated = post.data.updatedDate ? formatDate(post.data.updatedDate) : null;
---
<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <div id="progress"></div>

  <header class="post-head">
    <div class="wrap">
      <div class="kicker">
        {post.data.series ? `series / ${post.data.series}` : 'field notes'}
      </div>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>{date}</span>
        <span>{readingTime(post.body)} min read</span>
        {updated && <span>updated {updated}</span>}
        <span>{SITE.author}</span>
      </div>
      {
        post.data.tags.length > 0 && (
          <div class="tags" style="margin-top: 18px;">
            {post.data.tags.map((t) => (
              <a class="tag" href={url(`/tags/${encodeURIComponent(t)}`)}>
                {t}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <div class="wrap">
    <div class="post-layout">
      <div class="prose">
        <Content />
      </div>

      {
        toc.length > 2 && (
          <aside class="toc" aria-label="目录">
            <span class="label">CONTENTS</span>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class={`depth-${h.depth}`}>
                {h.text}
              </a>
            ))}
          </aside>
        )
      }
    </div>

    <nav class="post-nav" aria-label="文章导航">
      <div>
        {
          older && (
            <a href={url(`/notes/${older.id}`)}>
              <span class="k">← OLDER</span>
              <span class="t">{older.data.title}</span>
            </a>
          )
        }
      </div>
      <div style="text-align: right;">
        {
          newer && (
            <a href={url(`/notes/${newer.id}`)}>
              <span class="k">NEWER →</span>
              <span class="t">{newer.data.title}</span>
            </a>
          )
        }
      </div>
    </nav>
  </div>
</BaseLayout>

<script>
  // 代码块复制按钮
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.type = 'button';
    btn.textContent = 'COPY';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'COPIED';
      } catch {
        btn.textContent = 'FAILED';
      }
      setTimeout(() => (btn.textContent = 'COPY'), 1600);
    });
    pre.appendChild(btn);
  });

  // 阅读进度
  const bar = document.getElementById('progress');
  if (bar) {
    const update = () => {
      const el = document.documentElement;
      const max = el.scrollHeight - el.clientHeight;
      const ratio = max > 0 ? el.scrollTop / max : 0;
      bar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
