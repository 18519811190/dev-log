---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
import { url } from '../../consts';
import type { Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, items: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  items: Post[];
}

const { tag, items } = Astro.props;
---
<BaseLayout title={`标签：${tag}`} description={`标签 ${tag} 下的全部文章。`}>
  <div class="wrap">
    <section class="hero" style="padding: 64px 0 34px;">
      <h1 style="font-size: clamp(28px, 3.6vw, 46px);">{tag}</h1>
      <p class="sub">{items.length} 篇</p>
      <p class="latin"><a href={url('/tags')} style="color: inherit;">← all tags</a></p>
    </section>

    <div class="rows">
      {
        items.map((post) => (
          <a class="row" href={url(`/notes/${post.id}`)}>
            <span class="row-date">
              {formatDate(post.data.pubDate)} · {readingTime(post.body)} min
            </span>
            <span class="row-title">{post.data.title}</span>
            <span class="row-tags">
              {post.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
